# ==============================================================================
# BLUAMP MAIN - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure with your project credentials.
# DO NOT commit actual .env files to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CLIENT & BACKEND CONFIGURATION
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Supabase Server-Side API Key (for serverless functions and admin tasks)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------------------------
# 2. APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
VITE_APP_URL=http://localhost:5173
APP_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 3. AI & LLM PROVIDERS
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key
OPENROUTER_API_KEY=your_openrouter_api_key

# ------------------------------------------------------------------------------
# 4. SLACK NOTIFICATIONS & WEBHOOKS
# ------------------------------------------------------------------------------
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_WEBHOOK_URL_TO_DO=https://hooks.slack.com/services/YOUR/TODO/WEBHOOK
SLACK_WEBHOOK_URL_PERSONAL=https://hooks.slack.com/services/YOUR/PERSONAL/WEBHOOK

# ------------------------------------------------------------------------------
# 5. WHATSAPP CLOUD API INTEGRATION
# ------------------------------------------------------------------------------
WHATSAPP_VERIFY_TOKEN=your_whatsapp_webhook_verify_token
WHATSAPP_ACCESS_TOKEN=your_whatsapp_system_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
ALLOWED_WHATSAPP_NUMBERS=
